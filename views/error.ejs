<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="AI-powered resume review and interview preparation tool."
    />
    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="style.css" />
    <title>Interview AI</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
  </head>

  <body
    class="min-h-screen bg-gray-950 text-gray-200 flex items-center justify-center p-6"
  >
    <main
      role="alert"
      class="bg-gray-900/70 backdrop-blur-xl border border-gray-700/40 rounded-2xl shadow-[0_0_30px_rgba(0,0,0,0.6)] p-10 sm:p-12 max-w-lg w-full text-center"
    >
      <h1
        class="text-6xl sm:text-7xl font-extrabold mb-5 text-purple-400 drop-shadow-[0_0_12px_rgba(168,85,247,0.45)]"
      >
        <%= status %>
      </h1>

      <p class="text-lg sm:text-xl text-gray-300 mb-10 leading-relaxed">
        <%= message %>
      </p>

      <a
        href="/"
        class="inline-block bg-purple-600/30 border border-purple-500/40 px-8 py-3 rounded-xl text-lg font-semibold text-purple-200 hover:bg-purple-600/50 hover:border-purple-400/70 transition-all duration-300 shadow-md hover:shadow-purple-500/30"
      >
        Go Home
      </a>
    </main>
  </body>
</html>
