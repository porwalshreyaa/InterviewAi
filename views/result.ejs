<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="AI-powered resume review and interview preparation tool."
    />
    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="style.css" />
    <title>Interview AI</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
  </head>

  <body
    class="bg-gradient-to-br from-gray-950 via-gray-900 to-black text-gray-100 font-serif min-h-screen p-6"
  >
    <div
      class="max-w-4xl mx-auto mt-10 mb-20 p-8 sm:p-10 rounded-2xl bg-gray-900/70 border border-gray-700/40 shadow-2xl backdrop-blur-xl"
    >
      <!-- PAGE HEADER -->
      <header class="mb-10">
        <h1
          class="text-4xl sm:text-5xl font-bold text-purple-300 mb-3 drop-shadow-[0_0_10px_rgba(168,85,247,0.35)]"
        >
          AI Interview Results
        </h1>
        <p class="text-gray-300 leading-relaxed">
          Here is your personalized CV evaluation.
        </p>
      </header>

      <!-- SUMMARY -->
      <section
        class="bg-gray-900/70 border border-gray-700/40 p-6 rounded-xl mb-8"
      >
        <h2 class="text-2xl text-purple-300 font-bold mb-3">Summary</h2>
        <p class="text-gray-300 leading-relaxed"><%= data.summary %></p>
      </section>

      <!-- SKILLS -->
      <section
        class="bg-gray-900/70 border border-gray-700/40 p-6 rounded-xl mb-8"
      >
        <h2 class="text-2xl text-purple-300 font-bold mb-4">Skills</h2>

        <!-- Hard Skills -->
        <div class="mb-6">
          <p class="text-purple-200 font-semibold mb-2">Hard Skills</p>
          <div class="flex flex-wrap gap-2">
            <% data.skills.hardSkills.forEach(s => { %>
            <span
              class="px-3 py-1 rounded-full bg-purple-600/20 text-purple-200 border border-purple-500/30 text-sm"
            >
              <%= s %>
            </span>
            <% }) %>
          </div>
        </div>

        <!-- Soft Skills -->
        <div>
          <p class="text-purple-200 font-semibold mb-2">Soft Skills</p>
          <div class="flex flex-wrap gap-2">
            <% data.skills.softSkills.forEach(s => { %>
            <span
              class="px-3 py-1 rounded-full bg-purple-600/20 text-purple-200 border border-purple-500/30 text-sm"
            >
              <%= s %>
            </span>
            <% }) %>
          </div>
        </div>
      </section>

      <!-- SENIORITY -->
      <section
        class="bg-gray-900/70 border border-gray-700/40 p-6 rounded-xl mb-8"
      >
        <h2 class="text-2xl text-purple-300 font-bold mb-3">Seniority</h2>
        <span
          class="inline-block px-4 py-2 rounded-md bg-yellow-600/20 text-yellow-200 border border-yellow-500/30 font-semibold"
        >
          <%= data.seniority %>
        </span>
      </section>

      <!-- STRENGTHS & WEAKNESSES -->
      <section class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        <!-- Strengths -->
        <div class="bg-gray-900/70 border border-gray-700/40 p-6 rounded-xl">
          <h2 class="text-2xl text-purple-300 font-bold mb-3">Strengths</h2>
          <ul class="list-disc ml-6 text-gray-300 leading-relaxed">
            <% data.strengths.forEach(s => { %>
            <li><%= s %></li>
            <% }) %>
          </ul>
        </div>

        <!-- Weaknesses -->
        <div class="bg-gray-900/70 border border-gray-700/40 p-6 rounded-xl">
          <h2 class="text-2xl text-purple-300 font-bold mb-3">Weaknesses</h2>
          <ul class="list-disc ml-6 text-gray-300 leading-relaxed">
            <% data.weaknesses.forEach(w => { %>
            <li><%= w %></li>
            <% }) %>
          </ul>
        </div>
      </section>

      <!-- TECHNICAL QUESTIONS -->
      <section
        class="bg-gray-900/70 border border-gray-700/40 p-6 rounded-xl mb-8"
      >
        <h2 class="text-2xl text-purple-300 font-bold mb-3">
          Technical Questions
        </h2>
        <ul class="list-disc ml-6 text-gray-300 leading-relaxed">
          <% data.technicalQuestions.forEach(q => { %>
          <li><%= q %></li>
          <% }) %>
        </ul>
      </section>

      <!-- BEHAVIORAL QUESTIONS -->
      <section
        class="bg-gray-900/70 border border-gray-700/40 p-6 rounded-xl mb-12"
      >
        <h2 class="text-2xl text-purple-300 font-bold mb-3">
          Behavioral Questions
        </h2>
        <ul class="list-disc ml-6 text-gray-300 leading-relaxed">
          <% data.behavioralQuestions.forEach(q => { %>
          <li><%= q %></li>
          <% }) %>
        </ul>
      </section>

      <!-- BACK BUTTON -->
      <footer>
        <a
          href="/resume"
          class="block text-center w-full bg-purple-600/40 border border-purple-500/40 text-purple-200 py-3 rounded-lg font-semibold hover:bg-purple-600/60 hover:shadow-purple-500/30 transition shadow-md"
        >
          Back to Upload
        </a>
      </footer>
    </div>
  </body>
</html>
