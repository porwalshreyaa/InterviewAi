<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="AI-powered resume review and interview preparation tool."
    />
    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="style.css" />
    <title>Interview AI</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    <!-- Vue -->
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
  </head>

  <body class="bg-gradient-to-br from-gray-950 via-gray-900 to-black text-gray-100 font-serif font-light">
    <div id="app">

      <!-- Navbar -->
      <nav class="backdrop-blur-md bg-gray-900/80 border-b border-gray-700/50 fixed w-full z-20 shadow-lg">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <header class="flex items-center justify-between h-16">

            <a href="/" class="text-xl font-extrabold tracking-widest hover:text-purple-300 transition">
              Interview AI
            </a>

            <div class="hidden lg:flex space-x-6">
              <a
                v-for="item in navItems"
                :key="item.text"
                :href="item.href"
                class="hover:text-purple-300 px-2 py-2 font-semibold tracking-wide transition"
              >
                {{ item.text }}
              </a>
            </div>

            <button
              class="bg-purple-600/20 border border-purple-500/30 px-6 py-2 text-md text-purple-200 font-semibold rounded-lg hover:bg-purple-600/30 transition shadow-lg hover:shadow-purple-500/30"
            >
              Sign Up
            </button>

          </header>
        </div>
      </nav>

      <!-- Hero -->
      <section id="hero" class="pt-24 pb-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-14 items-center">

          <div class="animate-fadeSlideSlow">
            <h1 class="text-5xl md:text-6xl font-extrabold mb-6 leading-tight tracking-wide drop-shadow-[0_0_20px_rgba(168,85,247,0.25)]">
              Ace Your Interview
            </h1>

            <p class="text-xl md:text-2xl mb-8 text-gray-300">
              Resume Review. Interview Practice. Feedback.
            </p>

            <button
              @click="goToResume"
              class="bg-purple-600/20 border border-purple-500/30 text-purple-200 px-8 py-4 text-lg font-semibold rounded-lg hover:bg-purple-600/30 transition shadow-lg hover:shadow-purple-500/40"
            >
              Let's Go
            </button>
          </div>

          <!-- Hero Images -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <img
              v-for="(img, i) in heroImages"
              :key="i"
              :src="img"
              class="rounded-xl shadow-xl object-cover w-full transition-transform duration-300 hover:scale-[1.02]"
              :class="i === 0 ? 'col-span-1 sm:col-span-2 h-64' : 'h-48'"
              loading="lazy"
              draggable="false"
            />
          </div>

        </div>
      </section>

      <!-- Pricing -->
      <section id="pricing" class="py-24">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 animate-fadeSlide">

          <h2 class="text-4xl md:text-5xl font-bold text-center mb-10 tracking-wide text-purple-300">
            Pricing
          </h2>

          <p class="text-xl md:text-2xl mb-16 font-light text-center text-gray-300">
            Get started on the Basic plan for free — no credit card required.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 items-stretch">

            <div
              v-for="plan in plans"
              :key="plan.name"
              class="bg-gray-900/80 backdrop-blur-sm border border-gray-700/50 text-gray-200 rounded-2xl shadow-xl p-8 flex flex-col transition-all transform hover:-translate-y-2 hover:border-purple-500/50"
            >
              <img
                :src="plan.image"
                :alt="plan.name"
                class="rounded-xl mb-6 w-full h-48 object-cover opacity-90"
                loading="lazy"
              />

              <h3 class="text-xl font-bold text-center mb-2 text-purple-300 tracking-wide">
                {{ plan.name }}
              </h3>

              <p class="text-2xl font-bold text-center mb-4 text-gray-100">
                {{ plan.price }}
              </p>

              <ul class="mb-6 space-y-1 text-gray-400">
                <li v-for="(feat, i) in plan.features" :key="i">• {{ feat }}</li>
              </ul>

              <button
                :disabled="plan.disabled"
                class="mt-auto w-full bg-purple-600/40 border border-purple-500/40 px-8 py-3 text-lg font-semibold rounded-lg hover:bg-purple-600/60 transition shadow-md hover:shadow-purple-500/30 disabled:bg-gray-700 disabled:border-gray-600 disabled:text-gray-400"
              >
                {{ plan.disabled ? "Use" : "Buy" }}
              </button>
            </div>

          </div>
        </div>
      </section>

      <!-- Footer -->
      <footer class="text-gray-400 text-center py-8 bg-gray-950 border-t border-gray-800">
        <p class="text-sm tracking-wide">
          © 2025 Heuristic. All rights reserved.
        </p>
      </footer>

    </div>

    <!-- Vue App -->
    <script>
      const { createApp } = Vue;

      createApp({
        data() {
          return {
            navItems: [
              { text: "Pricing", href: "#pricing" },
              { text: "Blogs", href: "#" },
              { text: "FAQ", href: "#" },
            ],
            heroImages: [
              "/images/interview.png",
              "/images/programmar.jpg",
              "/images/resume.jpg",
            ],
            plans: [
              {
                name: "Basic",
                price: "Free",
                image: "/images/basic.png",
                features: [
                  "Get your resume reviewed",
                  "Get interview custom generated questions",
                ],
                disabled: true,
              },
              {
                name: "Pro",
                price: "Rs. 100/month",
                image:
                  "https://images.unsplash.com/photo-1566112718365-4c8ccbedc3d9?auto=format&w=1080",
                features: [
                  "Get your resume reviewed",
                  "Get interview custom generated questions",
                  "Submit answers and get feedback",
                ],
                disabled: false,
              },
              {
                name: "Ultra Pro",
                price: "Rs. 500/month",
                image:
                  "https://images.unsplash.com/photo-1684394213233-792d1ec08035?auto=format&w=1080",
                features: [
                  "Get your resume reviewed",
                  "Get interview custom generated questions",
                  "Submit answers and get feedback",
                  "Save evaluations & interview practice",
                ],
                disabled: false,
              },
            ],
          };
        },
        methods: {
          goToResume() {
            window.location.href = "/resume";
          },
        },
      }).mount("#app");
    </script>
  </body>
</html>
