<%- include('../partials/head', {
  title: 'Interview review — Interview AI',
  bodyClass: 'bg-slate-50 text-slate-900 antialiased min-h-screen flex flex-col'
}) %>

<%- include('../partials/navbar') %>

<main class="flex-1 max-w-4xl w-full mx-auto px-4 py-24">
  <header class="mb-10">
    <h1 class="section-title text-2xl sm:text-3xl font-bold mb-2">
      Interview review
    </h1>
    <p class="text-slate-600 text-sm">
      Summary of your mock interview for <strong><%= role %></strong>
    </p>
  </header>

  <section class="card rounded-xl p-6 mb-6">
    <div class="flex flex-wrap items-center gap-4 mb-4">
      <div>
        <p class="text-xs text-slate-500 uppercase tracking-wide mb-1">Overall score</p>
        <p class="text-3xl font-bold text-blue-600"><%= review.overallScore %>/10</p>
      </div>
      <div>
        <p class="text-xs text-slate-500 uppercase tracking-wide mb-1">Recommendation</p>
        <span class="badge-warning inline-block px-4 py-1.5 rounded-md text-sm font-semibold">
          <%= review.recommendation %>
        </span>
      </div>
    </div>
    <p class="text-slate-600 text-sm leading-relaxed"><%= review.overallSummary %></p>
  </section>

  <section class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
    <div class="card rounded-xl p-6">
      <h2 class="text-lg font-semibold text-slate-900 mb-3">Strengths shown</h2>
      <ul class="list-disc ml-5 text-slate-600 text-sm space-y-1">
        <% (review.strengthsShown || []).forEach(s => { %>
        <li><%= s %></li>
        <% }) %>
      </ul>
    </div>
    <div class="card rounded-xl p-6">
      <h2 class="text-lg font-semibold text-slate-900 mb-3">Areas to improve</h2>
      <ul class="list-disc ml-5 text-slate-600 text-sm space-y-1">
        <% (review.areasToImprove || []).forEach(s => { %>
        <li><%= s %></li>
        <% }) %>
      </ul>
    </div>
  </section>

  <section class="card rounded-xl p-6 mb-6">
    <h2 class="text-lg font-semibold text-slate-900 mb-4">Questions & your responses</h2>
    <div class="space-y-6">
      <% qaPairs.forEach((pair, i) => { %>
      <% const qr = review.questionReviews?.[i]; %>
      <article class="border-b border-slate-100 pb-6 last:border-0 last:pb-0">
        <div class="flex items-start gap-2 mb-2">
          <span class="badge-neutral px-2 py-0.5 rounded text-xs font-medium shrink-0"><%= pair.type %></span>
          <% if (qr) { %>
          <span class="text-xs font-semibold text-blue-600 ml-auto"><%= qr.score %>/10</span>
          <% } %>
        </div>
        <p class="font-medium text-slate-900 text-sm mb-2">Q<%= i + 1 %>: <%= pair.question %></p>
        <p class="text-slate-600 text-sm mb-2 pl-3 border-l-2 border-slate-200"><%= pair.answer %></p>
        <% if (qr) { %>
        <p class="text-slate-500 text-xs italic"><%= qr.feedback %></p>
        <% } %>
      </article>
      <% }) %>
    </div>
  </section>

  <div class="flex flex-col sm:flex-row gap-3">
    <a href="/interview" class="btn-secondary flex-1 text-center py-3 rounded-lg font-semibold text-sm">
      Retry interview
    </a>
    <a href="/resume" class="btn-primary flex-1 text-center py-3 rounded-lg font-semibold text-sm">
      Analyze another resume
    </a>
  </div>
</main>

<%- include('../partials/footer') %>
