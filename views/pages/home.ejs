<%- include('../partials/head', {
  title: 'Interview AI — Resume review & interview prep',
  loadVue: true,
  bodyClass: 'bg-slate-50 text-slate-900 antialiased min-h-screen flex flex-col'
}) %>

<div id="app" class="flex flex-col min-h-screen">
  <%- include('../partials/navbar', { variant: 'home' }) %>

  <main class="flex-1 pt-16">
    <section id="hero" class="py-16 sm:py-24">
      <div
        class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center"
      >
        <div class="animate-fade-in">
          <p
            class="inline-block text-xs font-semibold uppercase tracking-wider text-blue-600 bg-blue-50 px-3 py-1 rounded-full mb-6"
          >
            AI-powered career prep
          </p>
          <h1
            class="section-title text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight mb-6"
          >
            Prepare for interviews with confidence
          </h1>
          <p class="text-lg text-slate-600 mb-8 leading-relaxed max-w-xl">
            Upload your resume, specify your target role, and receive structured
            feedback plus tailored technical and behavioral questions.
          </p>
          <div class="flex flex-wrap gap-4">
            <button
              @click="goToResume"
              type="button"
              class="btn-primary px-8 py-3 rounded-lg text-base font-semibold"
            >
              Analyze my resume
            </button>
            <a
              href="#pricing"
              class="btn-secondary px-8 py-3 rounded-lg text-base font-semibold inline-flex items-center"
            >
              View pricing
            </a>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 animate-fade-in">
          <img
            v-for="(img, i) in heroImages"
            :key="i"
            :src="img"
            alt="Interview preparation"
            class="rounded-xl border border-slate-200 object-cover w-full shadow-md"
            :class="i === 0 ? 'sm:col-span-2 h-56 sm:h-64' : 'h-44 sm:h-48'"
            loading="lazy"
            draggable="false"
          />
        </div>
      </div>
    </section>

    <section id="features" class="py-20 bg-white border-y border-slate-200">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="section-title text-3xl font-bold text-center mb-4">
          What you get
        </h2>
        <p class="text-slate-600 text-center max-w-2xl mx-auto mb-12">
          A clear, actionable report built from your CV and the role you are targeting.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <article class="card rounded-xl p-6">
            <h3 class="font-semibold text-lg mb-2">Resume insights</h3>
            <p class="text-slate-600 text-sm leading-relaxed">
              Summary, skills breakdown, and seniority assessment aligned to your role.
            </p>
          </article>
          <article class="card rounded-xl p-6">
            <h3 class="font-semibold text-lg mb-2">Strengths & gaps</h3>
            <p class="text-slate-600 text-sm leading-relaxed">
              Highlight what stands out and where to improve before the interview.
            </p>
          </article>
          <article class="card rounded-xl p-6">
            <h3 class="font-semibold text-lg mb-2">Practice questions</h3>
            <p class="text-slate-600 text-sm leading-relaxed">
              Technical and behavioral prompts generated for your profile.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section id="pricing" class="py-20">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="section-title text-3xl font-bold text-center mb-4">
          Simple pricing
        </h2>
        <p class="text-slate-600 text-center mb-12">
          Start free on Basic — no credit card required.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch">
          <div
            v-for="plan in plans"
            :key="plan.name"
            class="card rounded-xl p-6 flex flex-col hover:shadow-md transition-shadow"
          >
            <img
              :src="plan.image"
              :alt="plan.name + ' plan'"
              class="rounded-lg mb-5 w-full h-40 object-cover border border-slate-100"
              loading="lazy"
            />
            <h3 class="text-lg font-semibold text-slate-900 mb-1">
              {{ plan.name }}
            </h3>
            <p class="text-2xl font-bold text-blue-600 mb-4">{{ plan.price }}</p>
            <ul class="mb-6 space-y-2 text-sm text-slate-600 flex-1">
              <li v-for="(feat, i) in plan.features" :key="i" class="flex gap-2">
                <span class="text-blue-600 shrink-0">&#10003;</span>
                <span>{{ feat }}</span>
              </li>
            </ul>
            <button
              type="button"
              :disabled="plan.disabled"
              class="w-full py-2.5 rounded-lg font-semibold text-sm"
              :class="plan.disabled ? 'btn-secondary' : 'btn-primary'"
            >
              {{ plan.disabled ? 'Current plan' : 'Upgrade' }}
            </button>
          </div>
        </div>
      </div>
    </section>

    <section id="faq" class="py-16 bg-white border-t border-slate-200">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
        <h2 class="section-title text-2xl font-bold mb-3">FAQ</h2>
        <p class="text-slate-600 text-sm leading-relaxed">
          Upload a PDF resume and enter your target role on the analyze page. Results
          are shown immediately after processing.
        </p>
      </div>
    </section>
  </main>
</div>

<%- include('../partials/footer', { pageScript: '/js/home.js' }) %>
