      </a>

      <% if (typeof variant !== 'undefined' && variant === 'home') { %>
      <div class="hidden md:flex items-center gap-8">
        <a
          v-for="item in navItems"
          :key="item.text"
          :href="item.href"
          class="text-sm font-medium text-slate-600 hover:text-blue-600 transition"
        >
          {{ item.text }}
