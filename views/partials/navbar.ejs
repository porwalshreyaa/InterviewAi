      </div>
      <a
        href="/resume"
        class="btn-primary text-sm font-medium px-5 py-2 rounded-lg"
      >
        Get started
      </a>
      <% } else { %>
      <div class="flex items-center gap-4">
        <a href="/" class="text-sm font-medium link-muted">Home</a>
        <a
          href="/resume"
          class="btn-primary text-sm font-medium px-5 py-2 rounded-lg"
