<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="AI-powered resume review and interview preparation."
    />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/main.css" />
    <title><%= typeof title !== 'undefined' ? title : 'Interview AI' %></title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <% if (typeof loadVue !== 'undefined' && loadVue) { %>
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <% } %>
  </head>
  <body
    class="<%= typeof bodyClass !== 'undefined' ? bodyClass : 'bg-slate-50 text-slate-900 antialiased min-h-screen' %>"
  >
