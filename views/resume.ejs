<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="AI-powered resume review and interview preparation tool."
    />
    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="style.css" />
    <title>Interview AI</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
  </head>

  <body
    class="bg-gradient-to-br from-gray-950 via-gray-900 to-black text-gray-100 font-serif min-h-screen flex items-center justify-center p-6"
  >
    <div
      class="max-w-3xl w-full p-8 sm:p-10 rounded-2xl bg-gray-900/70 border border-gray-700/40 shadow-2xl backdrop-blur-xl"
    >
      <!-- Title -->
      <h1
        class="text-4xl sm:text-5xl font-bold text-purple-300 mb-3 drop-shadow-[0_0_10px_rgba(168,85,247,0.35)]"
      >
        Resume Evaluation
      </h1>
      <p class="text-gray-300 mb-8 leading-relaxed">
        Upload your CV and enter the role you're applying for.
      </p>

      <form
        action="/analyze"
        method="post"
        enctype="multipart/form-data"
        class="space-y-6"
      >
        <!-- CV Upload -->
        <div>
          <label for="cvFile" class="block font-semibold mb-1 text-purple-200"
            >Your CV (PDF)</label
          >
          <input
            type="file"
            id="cvFile"
            name="cv"
            accept="application/pdf"
            class="w-full bg-gray-800 border border-gray-700/60 rounded-lg p-3 text-gray-200 file:bg-purple-600/40 file:text-purple-200 file:border-none file:px-4 file:py-2 hover:file:bg-purple-600/60 transition focus:ring-2 focus:ring-purple-500/40 focus:outline-none"
          />
        </div>

        <!-- Role Input -->
        <div>
          <label
            for="roleInput"
            class="block font-semibold mb-1 text-purple-200"
            >Target Role</label
          >
          <input
            type="text"
            id="roleInput"
            name="role"
            placeholder="e.g. Data Scientist"
            class="w-full bg-gray-800 border border-gray-700/60 rounded-lg p-3 text-gray-200 focus:ring-2 focus:ring-purple-500/40 focus:outline-none"
          />
        </div>

        <!-- Button -->
        <button
          id="submitCV"
          class="w-full bg-purple-600/40 border border-purple-500/40 text-purple-200 py-3 rounded-lg font-semibold hover:bg-purple-600/60 hover:border-purple-400/60 hover:shadow-purple-500/30 transition duration-300 shadow-md"
        >
          Analyze CV
        </button>
      </form>
    </div>
  </body>
</html>
